APP_NAME=RankedLaunch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@rankedlaunch.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# RankedLaunch launch queue
RL_FREE_WAIT_DAYS=28
RL_FREE_SLOTS_PER_DAY=10
RL_PAID_SLOTS_PER_DAY=10

# Launch offer: first RL_PROMO_LIMIT Listings cost RL_PROMO_PRICE (cents), then the regular price
RL_PROMO_ENABLED=true
RL_PROMO_PRICE=2000
RL_PROMO_LIMIT=50

# Payments: polar or lemonsqueezy
PAYMENT_PROVIDER=polar

# Polar (polar.sh). Webhook URL: APP_URL/webhooks/polar, event: order.paid
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SANDBOX=true
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_PRO_PROMO=
POLAR_PRODUCT_FEATURED=

# LemonSqueezy (only if PAYMENT_PROVIDER=lemonsqueezy)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_FEATURED=

# Social sign-in (callback: APP_URL/auth/{google|github|x}/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
